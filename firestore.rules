rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'go2025fast@gmail.com';
    }
    function isDriver() {
      return request.auth != null
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid))
        && get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.on == true;
    }
    match /config/{x} { allow read: if true; allow write: if isOwner(); }
    match /items/{x}  { allow read: if true; allow write: if isOwner(); }
    match /drivers/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow write: if isOwner();
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['online','seen']);
    }
    match /ftokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /reviews/{id} {
      allow create: if request.auth != null
        && request.resource.data.r is int && request.resource.data.r >= 1 && request.resource.data.r <= 5
        && request.resource.data.c.size() < 300;
      allow read: if isOwner();
      allow delete: if isOwner();
    }
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.total is number
        && request.resource.data.l is list && request.resource.data.l.size() <= 40
        && request.resource.data.n is string && request.resource.data.n.size() < 100
        && request.resource.data.p is string && request.resource.data.p.size() < 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.total == request.resource.data.sub - request.resource.data.disc + request.resource.data.fee
        && request.resource.data.disc <= request.resource.data.sub
        && request.resource.data.keys().hasOnly(['no','status','type','n','p','a','loc','y','c','l','sub','disc','fee','total','promo','ftok','createdAt']);
      allow get: if request.auth != null;
      allow list: if isOwner()
        || (isDriver() && resource.data.keys().hasAny(['drv']) && resource.data.drv.id == request.auth.uid);
      allow update: if isOwner()
        || (isDriver() && resource.data.keys().hasAny(['drv']) && resource.data.drv.id == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['delivering', 'done'])
        || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ftok']));
      allow delete: if isOwner();
    }
  }
}
